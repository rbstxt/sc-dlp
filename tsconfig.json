{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowJs": false,
    "declaration": true,
    "declarationDir": "./lib/types/",
    "rootDir": "./src/",
    "outDir": "./lib/",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM"]
  },
  "include": ["./src/**/*"]
}
