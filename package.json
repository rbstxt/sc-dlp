{
  "name": "sc-dlp",
  "version": "1.0.0",
  "description": "A downloader for Scratch projects.",
  "type": "module",
  "keywords": [
    "scratch",
    "turbowarp",
    "sb3",
    "sb2",
    "downloader",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rbstxt/sc-dlp.git"
  },
  "bugs": {
    "url": "https://github.com/rbstxt/sc-dlp/issues"
  },
  "homepage": "https://github.com/rbstxt/sc-dlp#readme",
  "engines": {
    "node": ">=18.17.0"
  },
  "main": "./lib/bundle-node.cjs",
  "module": "./lib/bundle-node.mjs",
  "types": "./lib/types/export-node.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/types/export-node.d.ts",
        "default": "./lib/bundle-node.mjs"
      },
      "require": {
        "types": "./lib/types/export-node.d.ts",
        "default": "./lib/bundle-node.cjs"
      }
    }
  },
  "files": [
    "lib/bundle-node.cjs",
    "lib/bundle-node.mjs",
    "lib/cli.cjs",
    "lib/types"
  ],
  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('lib', { recursive: true, force: true }))\"",
    "build": "npm run clean && rollup -c && tsc --emitDeclarationOnly && node -e \"import('node:fs').then(fs => fs.chmodSync('lib/cli.cjs', 0o755))\"",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "bin": {
    "sc-dlp": "lib/cli.cjs"
  },
  "directories": {
    "test": "test"
  },
  "dependencies": {
    "@turbowarp/json": "^0.1.2",
    "@turbowarp/jszip": "^3.12.0",
    "cli-progress": "^3.12.0",
    "kleur": "^4.1.5",
    "pako": "^2.1.0",
    "prompts": "^2.4.2",
    "undici": "^6.21.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^24.3.1",
    "@types/pako": "^2.0.4",
    "@types/prompts": "^2.4.9",
    "rollup": "^4.50.1",
    "rollup-plugin-license": "^3.6.0",
    "terser": "^5.44.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}